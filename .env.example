# Copy to .env (never commit .env)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# --- LLM: pick ONE -------------------------------------------------------------------
# Free option (Gemini free tier): get a key at https://aistudio.google.com/api-keys, then set a
# model that is on your free tier (check the model list in AI Studio, e.g. a "flash" model).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MIN_INTERVAL=7        # seconds between calls, keeps you under free-tier rate limits
LLM_MAX_CALLS=30          # hard cap per run, protects the free daily quota
# Fully local and free instead: LLM_BASE_URL=http://localhost:11434/v1 , LLM_MODEL=<an ollama model>, no key needed
# Paid option (Claude API): set ANTHROPIC_API_KEY and leave the LLM_* lines empty.
ANTHROPIC_API_KEY=
HUBSPOT_TOKEN=            # private-app token, scopes: crm.objects.companies read/write, crm.schemas.companies read/write
SLACK_DIGEST_WEBHOOK=
SLACK_ERROR_WEBHOOK=
HUBSPOT_PORTAL_ID=        # for record links
# Owners per segment (HubSpot owner ids), comma-separated for round-robin
OWNERS_SMB=
OWNERS_MID_MARKET=
OWNER_DEFAULT=
